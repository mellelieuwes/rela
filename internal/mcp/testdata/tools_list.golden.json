[
  {
    "name": "analyze",
    "description": "Check the graph against the schema. cardinality: relation min/max; properties: property values; validations: custom rules; unique: duplicate unique values; orphans: unconnected entities; schema: unused types.",
    "inputSchema": {
      "properties": {
        "check": {
          "enum": [
            "cardinality",
            "properties",
            "validations",
            "unique",
            "orphans",
            "schema"
          ],
          "type": "string"
        },
        "threshold": {
          "description": "schema only: report types with at most this many instances (default 0)",
          "type": "number"
        },
        "type": {
          "description": "orphans only: restrict to entity type",
          "type": "string"
        }
      },
      "required": [
        "check"
      ],
      "type": "object"
    }
  },
  {
    "name": "attach_file",
    "description": "Attach a file to an entity's file-type property. On a single-file property this replaces the current file; on a multi-file property it adds one, renaming it on a name clash. The upload policy (allowed types, scanning, size) applies. Maximum 16777216 bytes.",
    "inputSchema": {
      "properties": {
        "content": {
          "description": "File content, base64-encoded (standard alphabet, padded)",
          "type": "string"
        },
        "file_name": {
          "description": "File name, including extension",
          "type": "string"
        },
        "id": {
          "description": "Entity ID",
          "type": "string"
        },
        "property": {
          "description": "File-type property to attach to",
          "type": "string"
        }
      },
      "required": [
        "id",
        "property",
        "file_name",
        "content"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_entity",
    "description": "Create an entity. Call schema with the type first to see its properties.",
    "inputSchema": {
      "properties": {
        "content": {
          "description": "Markdown body",
          "type": "string"
        },
        "id": {
          "description": "Custom ID (only for types with id_type manual)",
          "type": "string"
        },
        "properties": {
          "description": "Property map",
          "properties": {},
          "type": "object"
        },
        "type": {
          "description": "Entity type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "properties"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_relation",
    "description": "Create a relation between two entities",
    "inputSchema": {
      "properties": {
        "content": {
          "description": "Markdown body",
          "type": "string"
        },
        "from": {
          "description": "Source entity ID",
          "type": "string"
        },
        "properties": {
          "description": "Property map",
          "properties": {},
          "type": "object"
        },
        "to": {
          "description": "Target entity ID",
          "type": "string"
        },
        "type": {
          "description": "Relation type",
          "type": "string"
        }
      },
      "required": [
        "from",
        "type",
        "to"
      ],
      "type": "object"
    }
  },
  {
    "name": "delete_attachment",
    "description": "Remove a file from an entity's file-type property. Deleting a named file that is not there succeeds.",
    "inputSchema": {
      "properties": {
        "file_name": {
          "description": "File to remove. May be omitted when the property holds exactly one file",
          "type": "string"
        },
        "id": {
          "description": "Entity ID",
          "type": "string"
        },
        "property": {
          "description": "File-type property holding the file",
          "type": "string"
        }
      },
      "required": [
        "id",
        "property"
      ],
      "type": "object"
    }
  },
  {
    "name": "delete_entity",
    "description": "Delete an entity",
    "inputSchema": {
      "properties": {
        "cascade": {
          "description": "Also delete its relations (default false)",
          "type": "boolean"
        },
        "id": {
          "description": "Entity ID",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "delete_relation",
    "description": "Delete a relation between two entities",
    "inputSchema": {
      "properties": {
        "from": {
          "description": "Source entity ID",
          "type": "string"
        },
        "to": {
          "description": "Target entity ID",
          "type": "string"
        },
        "type": {
          "description": "Relation type",
          "type": "string"
        }
      },
      "required": [
        "from",
        "type",
        "to"
      ],
      "type": "object"
    }
  },
  {
    "name": "find_path",
    "description": "Find the shortest path between two entities",
    "inputSchema": {
      "properties": {
        "from": {
          "description": "Source entity ID",
          "type": "string"
        },
        "to": {
          "description": "Target entity ID",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    }
  },
  {
    "name": "list_attachments",
    "description": "List the files attached to an entity's file-type properties",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Entity ID",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "list_entities",
    "description": "List entities as {id,type,title,status} summaries, sorted by ID. Result: {total,has_more,entities}.",
    "inputSchema": {
      "properties": {
        "filter": {
          "description": "Predicate expression, e.g. entity.status == 'open' and entity.priority ~= 'low', or related(entity, 'implements', { status = 'open' })",
          "type": "string"
        },
        "limit": {
          "description": "Max results (default 50)",
          "type": "number"
        },
        "offset": {
          "description": "Results to skip",
          "type": "number"
        },
        "type": {
          "description": "Entity type (required with filter)",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "name": "list_relations",
    "description": "List relations, filtered by type, source or target. Result: {total,has_more,relations}.",
    "inputSchema": {
      "properties": {
        "from": {
          "description": "Source entity ID",
          "type": "string"
        },
        "limit": {
          "description": "Max results (default 50)",
          "type": "number"
        },
        "offset": {
          "description": "Results to skip",
          "type": "number"
        },
        "to": {
          "description": "Target entity ID",
          "type": "string"
        },
        "type": {
          "description": "Relation type",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "name": "lua_eval",
    "description": "Execute Lua code against the rela graph. Use rela.output(data) to return results as JSON. Available functions: get_entity, list_entities, search, create_entity, update_entity, delete_entity, get_relations, create_relation, delete_relation, trace_from, trace_to, find_path, refresh, write_file, get_entity_types, get_relation_types. Context: rela.project_root, rela.args.",
    "inputSchema": {
      "properties": {
        "code": {
          "description": "Lua code to execute",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    }
  },
  {
    "name": "lua_run",
    "description": "Run a Lua script from the project's scripts/ directory. Omit path to list the available scripts. Use rela.output(data) to return results as JSON.",
    "inputSchema": {
      "properties": {
        "args": {
          "description": "Arguments, available as rela.args",
          "type": "array"
        },
        "path": {
          "description": "Script path within scripts/, e.g. reports/summary.lua",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "name": "read_attachment",
    "description": "Read one attached file. Raster images are returned as image content, UTF-8 text as text, and anything else as a base64 blob. Files over 10485760 bytes are refused.",
    "inputSchema": {
      "properties": {
        "file_name": {
          "description": "File name, as returned by list_attachments",
          "type": "string"
        },
        "id": {
          "description": "Entity ID",
          "type": "string"
        },
        "property": {
          "description": "File-type property holding the file",
          "type": "string"
        }
      },
      "required": [
        "id",
        "property",
        "file_name"
      ],
      "type": "object"
    }
  },
  {
    "name": "rename_entity",
    "description": "Change an entity's ID and update every relation that references it",
    "inputSchema": {
      "properties": {
        "dry_run": {
          "description": "Preview only (default false)",
          "type": "boolean"
        },
        "id": {
          "description": "Current ID",
          "type": "string"
        },
        "new_id": {
          "description": "New ID",
          "type": "string"
        }
      },
      "required": [
        "id",
        "new_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "schema",
    "description": "Describe the schema. Without type: every entity and relation type in one line each. With an entity or relation type: its properties, allowed values and relations.",
    "inputSchema": {
      "properties": {
        "type": {
          "description": "Entity or relation type",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "name": "search_entities",
    "description": "Full-text search across entity titles and properties",
    "inputSchema": {
      "properties": {
        "limit": {
          "description": "Max results (default 20)",
          "type": "number"
        },
        "query": {
          "description": "Search text",
          "type": "string"
        },
        "type": {
          "description": "Restrict to entity type",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    }
  },
  {
    "name": "show_entity",
    "description": "Get one entity: properties, markdown content, and relations grouped by type",
    "inputSchema": {
      "properties": {
        "content": {
          "description": "Include the markdown body (default true)",
          "type": "boolean"
        },
        "id": {
          "description": "Entity ID",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "trace",
    "description": "Walk the graph from an entity and return the reachable tree. direction both follows outgoing and incoming edges; upstream follows incoming edges only.",
    "inputSchema": {
      "properties": {
        "direction": {
          "description": "Default both",
          "enum": [
            "both",
            "upstream"
          ],
          "type": "string"
        },
        "id": {
          "description": "Start entity ID",
          "type": "string"
        },
        "max_depth": {
          "description": "Max depth (default 0 = unlimited)",
          "type": "number"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "update_entity",
    "description": "Update an entity. Only the named properties change; null removes one.",
    "inputSchema": {
      "properties": {
        "content": {
          "description": "New markdown body (replaces the old one)",
          "type": "string"
        },
        "id": {
          "description": "Entity ID",
          "type": "string"
        },
        "properties": {
          "description": "Properties to set; null removes",
          "properties": {},
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  }
]
